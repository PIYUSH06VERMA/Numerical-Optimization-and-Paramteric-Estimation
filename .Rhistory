##netwon raphson algorithm
NR<-function(X,l,gl,dgl,err=1e-6,max.it=1000)
{
old_l<-l
new_l<-l
for(i in 1:max.it)
{
old_l<-new_l
g<-gl(X,old_l)
dg<-dgl(X,old_l)
if(abs(dg) < 1e-12)
{
return(list(par=old_l,iter=i))
}
new_l<-old_l-g/dg
if(new_l<0)
{
new_l<-old_l/2
}
if(abs(new_l-old_l)<err)
{
return(list(par=new_l,iter=i))
}
}
return(list(par=old_l,iter=max.it))
}
