## so inputting this in log likelihood gives us the g_lambda function
g_lambda<-function(l)
{
n<-length(df)
out<-n*log(-n/(sum(log(1-exp(-l*df)))))+n*log(l)-l*sum(df)-sum(log(1-exp(-l*df)))
return(out)
